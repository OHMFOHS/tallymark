  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/schema.mjs",
    "test": "pnpm run build && vitest run",
    "lint": "eslint packages tests scripts && tsc -p tsconfig.check.json",
    "format:check": "prettier --check .",
    "prepack": "pnpm run build",
    "kit": "node dist/packages/cli/main.js",
    "test:package": "node scripts/package-smoke.mjs",
    "test:reference": "node scripts/reference-interop.mjs",
    "test:cancellation": "uv run --locked --project integrations/backburner python integrations/backburner/cancellation.py",
    "test:backburner": "uv run --locked --project integrations/backburner python integrations/backburner/validate.py"
  },
